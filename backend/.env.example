# AI Mega Assistant Backend Environment Configuration

PROJECT_NAME="AI Mega Assistant API"
API_V1_STR="/api"

# Primary AI Provider (Gemini)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-flash-latest"

# Database (MongoDB Atlas)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/mega_ai_assistant?retryWrites=true&w=majority"

# AI Resilience & Provider Failover Configurations
AI_PRIMARY_PROVIDER="gemini"
AI_FALLBACK_PROVIDER="" # Optional: "openai", "openrouter", "groq", or custom OpenAI-compatible provider
FALLBACK_API_KEY="" # Optional API Key for fallback provider
FALLBACK_MODEL="llama-3.1-8b-instant"
FALLBACK_API_BASE_URL="https://api.openai.com/v1"

AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_PROVIDER_COOLDOWN_SECONDS=30.0
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=300

# CORS Allowed Origins (JSON array or comma-separated string)
BACKEND_CORS_ORIGINS='["https://mega-ai-assistant-8p0ro4rxa-manisha61232752-3380s-projects.vercel.app", "http://localhost:5173", "http://127.0.0.1:5173"]'
